# Server
NODE_ENV=development
PORT=4002
SERVICE_NAME=user-service

# Database (user_db - owned exclusively by this service)
DB_HOST=user-db
DB_PORT=5432
DB_USERNAME=user_service_user
DB_PASSWORD=change_me
DB_DATABASE=user_db
DB_SSL=false

# JWT — verification only. This service NEVER issues tokens, only validates
# ones issued by auth-service, so it needs the same access-token secret
# (shared HS256 secret for Phase 2; recommend migrating to RS256 with a
# public key distributed via the shared @ora/auth-client package in Phase 3+).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

# Redis (token blacklist lookups — mirrors auth-service's blacklist for logout enforcement)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ora.user.events
# Consumed, not published — auth-service's exchange. This service listens for
# auth.registered on it to auto-activate a PENDING profile once its login
# credentials exist (no separate email-verification step in this platform).
AUTH_EXCHANGE=ora.auth.events

# Optional: auto-seeds a super-admin profile (ACTIVE, assigned USER + ADMIN
# roles) on first boot if SUPER_ADMIN_EMAIL is set (leave blank to disable).
# Idempotent — safe to leave set across restarts. Must match auth-service's
# SUPER_ADMIN_EMAIL exactly, so both services derive the same user id.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Logging
LOG_LEVEL=info

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
