# Server
NODE_ENV=development
PORT=4003
SERVICE_NAME=researcher-service

# Database (researcher_db - owned exclusively by this service)
DB_HOST=researcher-db
DB_PORT=5432
DB_USERNAME=researcher_service_user
DB_PASSWORD=change_me
DB_DATABASE=researcher_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other service.
# This service never calls auth-service or user-service over HTTP; it trusts
# the JWT locally for the caller's identity (userId, email) only. Role
# authorization is 100% local to this service's own database.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

LOG_LEVEL=info

# Optional: auto-assigns the module's BASE_ROLE (RESEARCHER_MEMBER) and
# TOP_ROLE (PLATFORM_ADMINISTRATOR) to this userId on first boot if
# SUPER_ADMIN_EMAIL is set (leave blank to disable). Idempotent — safe to
# leave set across restarts. Must match the platform-wide SUPER_ADMIN_EMAIL
# used by auth-service/user-service so every service derives the same
# userId for the same email.
SUPER_ADMIN_EMAIL=
