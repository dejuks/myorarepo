# Server
NODE_ENV=development
PORT=4004
SERVICE_NAME=repository-service

# Database (repository_db - owned exclusively by this service)
DB_HOST=repository-db
DB_PORT=5432
DB_USERNAME=repository_service_user
DB_PASSWORD=change_me
DB_DATABASE=repository_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other service.
# This module never calls another service over HTTP to check a caller's role;
# it only verifies the JWT locally for identity (userId, email) and looks up
# roles in its own database.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

# Logging
LOG_LEVEL=info

# Optional: assigns the platform super-admin both this module's base role
# (RESEARCHER_AUTHOR) and its top role (REPOSITORY_ADMINISTRATOR) on first
# boot if SUPER_ADMIN_EMAIL is set (leave blank to disable). Idempotent —
# safe to leave set across restarts. Must match the platform-wide
# SUPER_ADMIN_EMAIL exactly, so every service derives the same user id.
SUPER_ADMIN_EMAIL=
