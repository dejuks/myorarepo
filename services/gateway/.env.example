# Server
NODE_ENV=development
PORT=8080
SERVICE_NAME=api-gateway

# JWT — verification only (signature + expiry), same as every downstream
# service. The gateway rejects obviously invalid/expired tokens early as a
# fail-fast optimization; it does NOT check the Redis blacklist or roles —
# that deeper check still happens in each downstream service (defense in
# depth, not a single trust boundary). See docs/01-architecture.md §3.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

# Downstream service base URLs. Services not yet built (Phase 2 delivers
# one at a time) are still listed so routing is ready the moment they land;
# requests to their prefixes 503 until then (see proxy/service-registry.ts).
AUTH_SERVICE_URL=http://auth-service:4001
USER_SERVICE_URL=http://user-service:4002
RESEARCHER_SERVICE_URL=http://researcher-service:4003
REPOSITORY_SERVICE_URL=http://repository-service:4004
JOURNAL_SERVICE_URL=http://journal-service:4005
EBOOK_SERVICE_URL=http://ebook-service:4006
LIBRARY_SERVICE_URL=http://library-service:4007
WIKI_SERVICE_URL=http://wiki-service:4008
NOTIFICATION_SERVICE_URL=http://notification-service:4009
SEARCH_SERVICE_URL=http://search-service:4010
MONITORING_SERVICE_URL=http://monitoring-service:4011

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Proxy timeouts
PROXY_TIMEOUT_MS=15000

LOG_LEVEL=info
