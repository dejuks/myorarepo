# Server
NODE_ENV=development
PORT=4009
SERVICE_NAME=notification-service

# Database (notification_db - owned exclusively by this service)
DB_HOST=notification-db
DB_PORT=5432
DB_USERNAME=notification_service_user
DB_PASSWORD=change_me
DB_DATABASE=notification_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other service.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

# RabbitMQ — this service is primarily a CONSUMER, subscribing to every
# other service's exchange to react to domain events (see
# infrastructure/messaging/event-consumer.ts). It also owns its own
# exchange to publish NotificationSent/NotificationFailed events.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ora.notification.events
AUTH_EXCHANGE=ora.auth.events
USER_EXCHANGE=ora.user.events

# Email provider (External Integration Layer -> Email Service in
# docs/01-architecture.md §8; a ConsoleEmailProvider stub ships by default
# so this runs with zero external dependencies — swap EMAIL_PROVIDER to
# "smtp" and fill in the SMTP_* vars to send through Ethio Telecom Mail
# or any SMTP relay in staging/production).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ora-platform.org

LOG_LEVEL=info
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
