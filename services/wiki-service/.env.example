# Server
NODE_ENV=development
PORT=4008
SERVICE_NAME=wiki-service

# Database (wiki_db - owned exclusively by this service)
DB_HOST=wiki-db
DB_PORT=5432
DB_USERNAME=wiki_service_user
DB_PASSWORD=change_me
DB_DATABASE=wiki_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other service.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

LOG_LEVEL=info

# Optional bootstrap seed — if set, this userId (derived deterministically
# from the email, same UUID v5 scheme every service uses) is assigned both
# REGISTERED_EDITOR (base role) and BUREAUCRAT (top role) once at startup.
# Idempotent; safe to leave set across restarts. Leave blank to disable.
SUPER_ADMIN_EMAIL=
