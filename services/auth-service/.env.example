# Server
NODE_ENV=development
PORT=4001
SERVICE_NAME=auth-service

# Database (auth_db - owned exclusively by this service)
DB_HOST=auth-db
DB_PORT=5432
DB_USERNAME=auth_service_user
DB_PASSWORD=change_me
DB_DATABASE=auth_db
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

# Redis (token blacklist, rate limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ora.auth.events

# Used to build the verification/reset-password email links
FRONTEND_URL=http://localhost:3000

# Require every new account to click an emailed verification link before it
# can log in (production-correct default: true). Set to false ONLY for
# local/dev — new accounts are then created ACTIVE immediately, with no
# token issued and no email sent. Never set false in staging/production.
REQUIRE_EMAIL_VERIFICATION=true

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Optional: auto-seeds a super-admin login credential on first boot if both
# are set (leave both blank to disable). Idempotent — safe to leave set
# across restarts. Must match user-service's SUPER_ADMIN_EMAIL exactly.
# CHANGE THE PASSWORD before running this anywhere beyond your own machine.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=info
