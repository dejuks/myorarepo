# Server
NODE_ENV=development
PORT=4005
SERVICE_NAME=journal-service

# Database (journal_db - owned exclusively by this service)
DB_HOST=journal-db
DB_PORT=5432
DB_USERNAME=journal_service_user
DB_PASSWORD=change_me
DB_DATABASE=journal_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other service.
# This service never issues tokens; it only trusts the JWT for the caller's
# IDENTITY (userId, email). It never calls another service over HTTP to check
# roles — role lookup is 100% local to this service's own database.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

LOG_LEVEL=info

# Optional: bootstraps the module admin (assigns JOURNAL_MANAGER + AUTHOR to
# this email) on first boot if set (leave blank to disable). Idempotent —
# safe to leave set across restarts. Should match the platform's
# SUPER_ADMIN_EMAIL so the platform super-admin also administers this module.
SUPER_ADMIN_EMAIL=
