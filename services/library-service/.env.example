# Server
NODE_ENV=development
PORT=4007
SERVICE_NAME=library-service

# Database (library_db - owned exclusively by this service)
DB_HOST=library-db
DB_PORT=5432
DB_USERNAME=library_service_user
DB_PASSWORD=change_me
DB_DATABASE=library_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other
# service. This service never issues tokens, it only verifies ones issued
# by auth-service and trusts the claims for identity (userId, email); role
# authorization is 100% local to this service's own database (see
# docs/erd.md for why).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

LOG_LEVEL=info

# Optional: auto-assigns the platform super-admin both this module's base
# role (MEMBER) and its top role (LIBRARY_MANAGER) on first boot, using the
# same deterministic UUID v5 user id every service derives from this email
# (leave blank to disable). Idempotent — safe to leave set across restarts.
SUPER_ADMIN_EMAIL=
