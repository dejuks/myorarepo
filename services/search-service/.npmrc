# Makes `npm ci` resilient to transient network blips during Docker builds
# (slow/flaky connections, proxies, middleboxes killing long-lived
# connections). Without this, a single dropped packet partway through a
# large install can fail the whole build with ECONNRESET.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
