# Server
NODE_ENV=development
PORT=4010
SERVICE_NAME=search-service

# Database (search_db - owned exclusively by this service)
DB_HOST=search-db
DB_PORT=5432
DB_USERNAME=search_service_user
DB_PASSWORD=change_me
DB_DATABASE=search_db
DB_SSL=false

# RabbitMQ — this service is exclusively a CONSUMER. It subscribes to every
# content service's topic exchange (see infrastructure/messaging/event-consumer.ts)
# and maintains its own index; it is safe to truncate search_documents and
# rebuild it by replaying these events. RABBITMQ_EXCHANGE is reserved for
# this service's own future events (none are published today).
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ora.search.events
JOURNAL_EXCHANGE=ora.journal.events
EBOOK_EXCHANGE=ora.ebook.events
LIBRARY_EXCHANGE=ora.library.events
REPOSITORY_EXCHANGE=ora.repository.events
WIKI_EXCHANGE=ora.wiki.events
RESEARCHER_EXCHANGE=ora.researcher.events

LOG_LEVEL=info
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50
