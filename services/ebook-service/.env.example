# Server
NODE_ENV=development
PORT=4006
SERVICE_NAME=ebook-service

# Database (ebook_db - owned exclusively by this service)
DB_HOST=ebook-db
DB_PORT=5432
DB_USERNAME=ebook_service_user
DB_PASSWORD=change_me
DB_DATABASE=ebook_db
DB_SSL=false

# JWT — verification only, same shared-secret contract as every other service.
# This service never calls auth-service or user-service over HTTP: it trusts
# the JWT for the caller's identity (userId, email) and resolves *roles*
# entirely from its own local database (see docs/erd.md).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ISSUER=ora-platform
JWT_AUDIENCE=ora-platform-clients

LOG_LEVEL=info

# Optional: auto-assigns AUTHOR_RESEARCHER + BOOK_EDITOR (this module's base
# and top roles) to the deterministic bootstrap user id derived from this
# email, on first boot (leave blank to disable). Idempotent — safe to leave
# set across restarts. Must match the platform-wide SUPER_ADMIN_EMAIL used
# by auth-service/user-service so this module's bootstrap admin is the same
# person as the platform super-admin.
SUPER_ADMIN_EMAIL=
